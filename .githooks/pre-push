#!/bin/sh
# Kalite kapisi — push oncesi.
#
# Arka planda bir sey baslatmaz; kontrolleri calistirir, biter, sonucunu cikis
# koduyla soyler. Bloklamasi isin ta kendisidir.
#
# Kontroller ortak altin-kapi kitinde (`kapi`). Kit ci.yml'deki
# `run: cargo …` satirlarini aynen kosar,
# sonra kapi.toml'da uygulanir denen boyutlari olcer: karakter yazimi, hata
# disiplini, sandik siniri. Kurulum: cargo install --path ../altin-kapi
#
# Atlatma (ikisi de bilincli ve gorunur):
#   git push --no-verify
#   ARCHIFY_SKIP_GATE=1 git push

[ -n "$ARCHIFY_SKIP_GATE" ] && {
  echo "pre-push: ARCHIFY_SKIP_GATE ayarli — kapi atlandi." >&2
  exit 0
}

# Yalniz silme itiyorsan calistiracak bir sey yok. pre-push stdin'den
# "<yerel ref> <yerel sha> <uzak ref> <uzak sha>" alir; silmede yerel sha sifirdir.
itilecek=0
while read -r _lref lsha _rref _rsha; do
  case "$lsha" in
    "" | 0000000000000000000000000000000000000000) ;;
    *) itilecek=1 ;;
  esac
done
[ "$itilecek" = 1 ] || exit 0

kok=$(git rev-parse --show-toplevel) || exit 0
cd "$kok" || exit 0

# git kancaya depo-yerel ortam değişkenleri verir (bağlı çalışma ağacından
# itilince GIT_DIR MUTLAK yol olur). cargo test'in doğurduğu her `git`
# (testlerin geçici depoları, envanterin `git remote get-url`u) bunu miras alır
# ve current_dir'i yok sayıp bu depoya konuşur: ölçüm yanlış depoyu görür
# (`sinif` "yerel" yerine "benim" çıktı) ve testler bu deponun config'ine yazar.
# Kapı depodan bağımsız git çalıştırmalı; kanca ortamı burada temizlenir.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH

# Cargo'yu PATH'te ara, sonra rustup'in standart yerinde. Ikinci adim GitHub
# Desktop icin: kancalari dar bir ortamla calistirir ve ~/.cargo/bin cogu zaman
# icinde olmaz. post-commit'in pasli.exe icin yaptiginin aynisi.
CARGO_BIN="$(command -v cargo 2>/dev/null || true)"
[ -n "$CARGO_BIN" ] || for c in "$HOME/.cargo/bin/cargo" "$USERPROFILE/.cargo/bin/cargo.exe"; do
  [ -x "$c" ] && { CARGO_BIN="$c"; break; }
done
[ -n "$CARGO_BIN" ] || {
  echo "pre-push: cargo bulunamadi — kapi OLCULMEDI (yesil degil). CI son savunma." >&2
  exit 0
}
# kapi, cargo'yu PATH'ten cagirir; kapi.exe de ayni dizinde durur.
PATH="$(dirname "$CARGO_BIN"):$PATH"
export PATH

# Kit yoksa kontroller hic kosmamistir: bu yesil degil, kirmizidir.
command -v kapi >/dev/null 2>&1 || {
  echo "pre-push: kapi bulunamadi. Kur: cargo install --path ../altin-kapi" >&2
  echo "  Yine de it : ARCHIFY_SKIP_GATE=1 git push" >&2
  exit 1
}

echo "pre-push: altin kapi kosuyor (ag yok)…" >&2
basla=$(date +%s)
kapi . >&2
sonuc=$?

echo "pre-push: kapi $(( $(date +%s) - basla )) sn surdu." >&2

[ "$sonuc" = 0 ] || {
  echo "" >&2
  echo "PUSH DURDURULDU — kapi kirmizi. Ayrinti yukarida." >&2
  echo "  Bicim ise  : cargo fmt --all" >&2
  echo "  Yine de it : git push --no-verify" >&2
  exit 1
}

exit 0
